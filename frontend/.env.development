# Dev: browser talks to the FastAPI backend cross-origin.
# Backend CORS already allows http://localhost:3001 / http://127.0.0.1:3001.
# Use 127.0.0.1 (not "localhost"): on Windows the browser resolves "localhost"
# to IPv6 ::1, but uvicorn binds IPv4 only -> "Failed to fetch".
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8002
NEXT_PUBLIC_WS_BASE=ws://127.0.0.1:8002
