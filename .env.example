# =============================================================================
# IBVAP — Environment Configuration
# =============================================================================

# Application
APP_NAME=IBVAP
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
DATABASE_URL=sqlite:///./ibvap.db

# Paths
MODELS_DIR=./models
OUTPUTS_DIR=./outputs
SNAPSHOTS_DIR=./outputs/snapshots
LOGS_DIR=./outputs/logs

# Detection
DETECTION_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.40
DETECTION_DEVICE=auto

# Tracking
TRACKER_TYPE=bytetrack

# Face Recognition (Optional)
FACE_ENABLED=false
FACE_MODEL=buffalo_l
FACE_SIMILARITY_THRESHOLD=0.45

# ANPR (Optional)
ANPR_ENABLED=false
