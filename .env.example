# =============================================================================
# IBVAP — Environment Configuration
# =============================================================================

# Application
APP_NAME=IBVAP
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# For local development with SQLite:
# DATABASE_URL=sqlite:///./ibvap.db
# For Docker/PostgreSQL: docker-compose.yml builds DATABASE_URL itself from
# POSTGRES_PASSWORD (put it in a .env next to docker-compose.yml). Use a long random
# value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://ibvap:<POSTGRES_PASSWORD>@db:5432/ibvap

# Paths
MODELS_DIR=./models
OUTPUTS_DIR=./outputs
SNAPSHOTS_DIR=./outputs/snapshots
LOGS_DIR=./outputs/logs

# Detection
DETECTION_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.40
DETECTION_DEVICE=auto

# Tracking
TRACKER_TYPE=bytetrack

# Face Recognition (Optional)
FACE_ENABLED=false
FACE_MODEL=buffalo_l
FACE_SIMILARITY_THRESHOLD=0.45

# ANPR (Optional)
ANPR_ENABLED=false

# Supabase (get these from `npx supabase status` after starting local Supabase)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-supabase-anon-key-here

# Frontend (Vite — prefix with VITE_)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
