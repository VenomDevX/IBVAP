# =============================================================================
# IBVAP — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
backend/venv/
.venv/
venv/

# --- Node ---
frontend/node_modules/
frontend/dist/

# --- Environment / Secrets ---
.env
.env.local
.env.production
.env.*.local
*.pem
*.key
signing_keys.json

# --- Database ---
*.db
*.sqlite3

# --- AI Models (large files) ---
backend/models/detection/*.pt
backend/models/face/*
backend/models/anpr/*
backend/models/risk/*
!backend/models/**/.gitkeep

# --- Dataset & Training Data ---
backend/data/
data/
datasets/
dataset/
*.jpg
*.jpeg
*.png
*.bmp
*.tiff
*.mp4
*.avi
*.mov
*.mkv

# --- External Dataset Drive ---
# If your dataset is on J:\Data set or similar, it's outside the repo
# but this ensures any copied/symlinked data dirs are excluded
**/Data set/
**/data set/

# --- YOLO Training Runs ---
runs/
backend/runs/

# --- Model Weights ---
*.pt
*.pth
*.weights
*.onnx
*.tflite
*.engine

# --- Runtime Outputs ---
outputs/
backend/outputs/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Supabase ---
supabase/.temp/
supabase/.branches/

# --- Misc ---
*.log
.agents/

# --- Semgrep / tooling caches ---
.semgrep/
**/.semgrep/
.mypy_cache/
**/.mypy_cache/
*.code-workspace

# --- Raw dataset drops at repo root (never commit) ---
/License Plate Recognition*/
/*.yolov8/
/*.v[0-9]*i.yolov8/
