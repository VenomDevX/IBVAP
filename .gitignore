# =============================================================================
# IBVAP — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
backend/venv/

# --- Node ---
frontend/node_modules/
frontend/dist/

# --- Environment ---
.env
.env.local
.env.production

# --- Database ---
*.db
*.sqlite3

# --- AI Models (large files) ---
backend/models/detection/*.pt
backend/models/face/*
backend/models/anpr/*
backend/models/risk/*
!backend/models/**/.gitkeep

# --- Dataset & Training Data ---
backend/data/
data/
*.jpg
*.jpeg
*.png
*.mp4
*.avi
*.mov

# --- YOLO Training Runs ---
runs/
backend/runs/

# --- Model Weights ---
*.pt
*.pth
*.weights
*.onnx

# --- Runtime Outputs ---
outputs/
backend/outputs/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Supabase ---
supabase/.temp/

# --- Misc ---
*.log
.agents/
