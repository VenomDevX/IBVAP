# =============================================================================
# IBVAP — Environment Variables Template
# Copy this to .env and fill in your values
# =============================================================================

# ── Application Mode ──
# "development" = API docs enabled, verbose logging
# "production"  = API docs disabled, security hardened
IBVAP_ENV=development

# ── Server ──
IBVAP_HOST=0.0.0.0
IBVAP_PORT=8000

# ── Supabase Authentication ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-supabase-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
# Service-role key — backend-only, resolves application roles from user_profiles
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
# Optional: enforce the JWT `iss` claim. Leave BLANK unless it exactly matches a real token.
SUPABASE_JWT_ISSUER=
# Optional local-dev only: a static bearer token that authenticates as admin. Leave BLANK.
IBVAP_DEV_BYPASS=

# ── Evidence integrity ──
# HMAC key for the tamper-evident alert/event hash chain (keep secret, back up)
EVIDENCE_HMAC_KEY=change-me-to-a-long-random-string

# ── Security ──
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated list of trusted host headers
TRUSTED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Directories (use defaults unless deploying elsewhere) ──
IBVAP_CONFIG_DIR=./configs
IBVAP_OUTPUT_DIR=./outputs
IBVAP_MODEL_DIR=./models
IBVAP_DATA_DIR=./data
IBVAP_SNAPSHOTS_DIR=./outputs/snapshots

# ── Model Weights ──
# Coarse detector weights — also settable via configs/thresholds.yaml -> detection.weights_path
YOLO_WEIGHTS=./outputs/training/ibvap_coarse/weights/best.pt

# Phase 2 (fine-grained military-type classifier) — NOT used by the runtime today
# RESNET_WEIGHTS=./outputs/classifier/best.pt
# CLASS_MAPPING=./outputs/classifier/class_mapping.json

# ── Notifications (Email/SMS) ──
# SMTP Configuration for Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_TARGET_EMAIL=

# Twilio Configuration for SMS
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUM=
ALERT_TARGET_PHONE=

# ── Deployment (production) ──
# Set only when the app sits behind a reverse proxy you control:
TRUSTED_PROXY=0
# Comma-separated Host headers the app will answer to (else it 400s):
TRUSTED_HOSTS=localhost,127.0.0.1
# Comma-separated allowed browser origins for the API:
CORS_ORIGINS=http://localhost,http://localhost:5173

# Local-dev login: run `python scripts/seed_users.py --defaults` after `supabase migration up`
# to create admin@ibvap.local / operator@ibvap.local using these passwords:
IBVAP_ADMIN_PASSWORD=admin123
IBVAP_OPERATOR_PASSWORD=operator123
