# =============================================================================
# IBVAP — Environment Variables Template
# Copy this to .env and fill in your values
# =============================================================================

# ── Application Mode ──
# "development" = API docs enabled, verbose logging
# "production"  = API docs disabled, security hardened
IBVAP_ENV=development

# ── Server ──
IBVAP_HOST=0.0.0.0
IBVAP_PORT=8000

# ── Supabase Authentication ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-supabase-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Security ──
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated list of trusted host headers
TRUSTED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Directories (use defaults unless deploying elsewhere) ──
IBVAP_CONFIG_DIR=./configs
IBVAP_OUTPUT_DIR=./outputs
IBVAP_MODEL_DIR=./models
IBVAP_DATA_DIR=./data
IBVAP_SNAPSHOTS_DIR=./outputs/snapshots

# ── Model Weights ──
# Path to YOLO detection weights
YOLO_WEIGHTS=./runs/detect/outputs/training/ibvap_custom_model/weights/best.pt

# Path to ResNet classifier weights
RESNET_WEIGHTS=./outputs/classifier/best.pt

# Path to class mapping JSON
CLASS_MAPPING=./outputs/classifier/class_mapping.json

# ── Notifications (Email/SMS) ──
# SMTP Configuration for Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_TARGET_EMAIL=

# Twilio Configuration for SMS
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUM=
ALERT_TARGET_PHONE=
